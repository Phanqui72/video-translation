<?xml version="1.1" encoding="UTF-8" standalone="no"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- ========================================= -->
    <!-- CHANGESET: Create Project Table           -->
    <!-- ========================================= -->
    <changeSet id="2.0.0-create-project-table" author="mgr-api">
        <createTable tableName="db_mgr_project">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="title" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="TEXT"/>
            <column name="thumbnail_url" type="VARCHAR(500)"/>
            <column name="project_status" type="VARCHAR(20)" defaultValue="draft"/>
            <column name="visibility" type="VARCHAR(20)" defaultValue="private"/>
            <column name="account_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="created_date" type="DATETIME">
                <constraints nullable="false"/>
            </column>
            <column name="modified_by" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="modified_date" type="DATETIME">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="INT" defaultValueNumeric="1"/>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="db_mgr_project"
                baseColumnNames="account_id"
                constraintName="fk_project_account"
                referencedTableName="db_mgr_account"
                referencedColumnNames="id"/>

        <createIndex indexName="idx_project_account_id" tableName="db_mgr_project">
            <column name="account_id"/>
        </createIndex>
        <createIndex indexName="idx_project_status" tableName="db_mgr_project">
            <column name="project_status"/>
        </createIndex>
    </changeSet>

    <!-- ========================================= -->
    <!-- CHANGESET: Create Video Table             -->
    <!-- ========================================= -->
    <changeSet id="2.0.0-create-video-table" author="mgr-api">
        <createTable tableName="db_mgr_video">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="project_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="account_id" type="BIGINT"/>
            <column name="original_filename" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="storage_url" type="VARCHAR(500)"/>
            <column name="duration_seconds" type="INT"/>
            <column name="resolution" type="VARCHAR(50)"/>
            <column name="file_size" type="BIGINT"/>
            <column name="file_format" type="VARCHAR(20)"/>
            <column name="language_source" type="VARCHAR(10)"/>
            <column name="upload_status" type="VARCHAR(20)" defaultValue="pending"/>
            <column name="content_type" type="VARCHAR(100)"/>
            <column name="created_by" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="created_date" type="DATETIME">
                <constraints nullable="false"/>
            </column>
            <column name="modified_by" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="modified_date" type="DATETIME">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="INT" defaultValueNumeric="1"/>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="db_mgr_video"
                baseColumnNames="project_id"
                constraintName="fk_video_project"
                referencedTableName="db_mgr_project"
                referencedColumnNames="id"/>

        <addForeignKeyConstraint
                baseTableName="db_mgr_video"
                baseColumnNames="account_id"
                constraintName="fk_video_account"
                referencedTableName="db_mgr_account"
                referencedColumnNames="id"/>

        <createIndex indexName="idx_video_project_id" tableName="db_mgr_video">
            <column name="project_id"/>
        </createIndex>
        <createIndex indexName="idx_video_account_id" tableName="db_mgr_video">
            <column name="account_id"/>
        </createIndex>
        <createIndex indexName="idx_video_upload_status" tableName="db_mgr_video">
            <column name="upload_status"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
